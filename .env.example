# Node >=22.16，零 npm 依赖。真实环境变量优先于此文件。
# 复制为 .env 后填写；不要提交真实凭据。
# 指定其他文件：REEL_BRIDGE_ENV_FILE=/absolute/path/.env
# 禁用自动读取 .env：REEL_BRIDGE_ENV_FILE=""（在 MCP 的 env 中设置）

# 模式：留空自动托管 Docker；已有实例填写 URL（不会操作 Docker）。
PANSOU_URL=
# 外部实例已开启认证时两项一起填；托管模式无需填，会自动生成持久凭据。
PANSOU_USER=
PANSOU_PASS=
PANSOU_TIMEOUT=90000

# 托管模式专用；数据始终放在稳定绝对路径，不依赖启动目录或 npx 缓存。
# REEL_BRIDGE_DATA_DIR=~/.reel-bridge
PANSOU_PORT=7742
PANSOU_STARTUP_TIMEOUT=300000
# 默认 latest，但启动仅拉缺失镜像；生产建议指定已验证 tag 或 sha256 digest。
PANSOU_IMAGE=ghcr.io/fish2018/pansou-web:latest
# Linux 代理需允许容器网段访问；macOS/OrbStack 的主机别名按运行环境确认。
PROXY=
# PROXY=http://host.docker.internal:7890

# Gying 可选：通过 PanSou 自动复用/初始化登录，不再提供独立管理工具。
# 中文域名会自动转换为 punycode；只填站点，不含路径。
GYING_URL=
GYING_USER=
GYING_PASS=
# 必须与外部 PanSou 的 GYING_HASH_SALT 相同；托管模式会自动传入。
# GYING_HASH_SALT=pansou_gying_secret_2025

# CMS 可选：两项同时填写才注册 cms_add_share / cms_sync。
# 不会在启动或搜索后自动提交任务。不要使用公开默认 token。
CMS_URL=
CMS_TOKEN=
CMS_TIMEOUT=30000

# 仅根目录 docker-compose.yml 手动部署使用；托管运行时不使用这两项。
# AUTH_USERS=admin:your-password
# AUTH_JWT_SECRET=your-long-random-secret
